# ==== Server ====
PORT=4000
NODE_ENV=development

# ==== Database ====
# Chuỗi kết nối MongoDB (local hoặc MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/short-video-platform

# ==== Auth ====
# Chuỗi bí mật dùng để ký JWT. Sinh bằng: openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-bi-mat-cua-ban

# ==== CORS ====
# Danh sách origin được phép, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000

# ==== AWS S3 (luu tru video) ====
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
